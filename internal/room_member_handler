// Remove POST /rooms/:id/members/:userId/remove
func (h *RoomMemberHandler) Remove(c *gin.Context) {
	roomID, _ := strconv.ParseUint(c.Param("id"), 10, 64)
	targetUserID, _ := strconv.ParseUint(c.Param("userId"), 10, 64)
	ownerID := c.GetUint("userID")

	if err := h.svc.RemoveMember(c.Request.Context(), uint(roomID), uint(targetUserID), uint(ownerID)); err != nil {
		c.JSON(http.StatusForbidden, gin.H{"error": err.Error()})
		return
	}
	c.JSON(http.StatusOK, gin.H{"message": "移除成功"})
}
